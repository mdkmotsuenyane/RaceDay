@model List<RaceDay.DTOs.EventResponseDto>
@{
    ViewBag.Title = "All Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Upcoming Events</h2>
    </div>

    <!-- Search Bar -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Search by event name or location..." value="@ViewBag.CurrentFilter" />
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No events found. Check back later!</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var ev in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        
                        <!-- Image handling (Azure or Local) -->
                        @if (!string.IsNullOrEmpty(ev.ImageUrl))
                        {
                            var imageSrc = ev.ImageUrl.StartsWith("/uploads/") 
                                ? $"https://localhost:7100{ev.ImageUrl}" 
                                : ev.ImageUrl;

                            <img src="@imageSrc" class="card-img-top" alt="@ev.Name" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 180px;">
                                <span class="fs-1">🏃</span>
                            </div>
                        }

                        <div class="card-body">
                            <span class="badge bg-primary mb-2">@ev.Status</span>
                            <h5 class="card-title">@ev.Name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@ev.EventDate.ToString("dd MMM yyyy")</h6>
                            <p class="card-text text-truncate">@ev.Description</p>
                            <p class="card-text"><small class="text-muted">📍 @ev.Location</small></p>
                        </div>
                        <div class="card-footer bg-transparent border-top-0">
                            <a asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-outline-primary w-100">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
