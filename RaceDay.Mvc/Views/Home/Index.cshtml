@{ ViewBag.Title = "Home"; }

<div class="text-center mt-5 mb-5 py-5" style="background: linear-gradient(135deg, #1A1A2E 0%, #16213E 100%); border-radius: 20px; color: white; box-shadow: 0 15px 30px rgba(0,0,0,0.2);">
    <div class="container py-4">
        <h1 class="display-3 fw-bold mb-3" style="font-family: 'Montserrat', sans-serif;">
            Find Your <span style="color: var(--indela-primary);">iNDLELA</span>
        </h1>
        <p class="lead mb-4" style="font-family: 'Inter', sans-serif; font-size: 1.2rem; color: #d1d1d1;">
            The ultimate platform for South African road running, walking, and cycling events.
        </p>
        <div class="mt-4">
            <a class="btn btn-primary btn-lg me-3" asp-controller="Events" asp-action="Index">Browse Events</a>
            @if (Context.Session.GetString("JwtToken") == null)
            {
                <a class="btn btn-outline-light btn-lg" style="border-radius: 50px;" asp-controller="Account" asp-action="Register">Join iNDLELA</a>
            }
        </div>
    </div>
</div>

<div class="row text-center mt-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm p-4">
            <div class="fs-1 mb-3">🏃‍♂️</div>
            <h4 class="card-title">Enter Races</h4>
            <p class="text-muted">Register for top South African marathons, ultra-marathons, and cycle tours.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm p-4">
            <div class="fs-1 mb-3">🏆</div>
            <h4 class="card-title">Track Results</h4>
            <p class="text-muted">View your personal race history, finish times, and overall placements.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm p-4">
            <div class="fs-1 mb-3">🌤️</div>
            <h4 class="card-title">Race Day Ready</h4>
            <p class="text-muted">Check live weather forecasts, route maps, and elevation profiles.</p>
        </div>
    </div>
</div>
