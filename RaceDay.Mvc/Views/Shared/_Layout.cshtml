<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - iNDLELA</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/logo.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Mvc.styles.css" asp-append-version="true" />

    <!-- Custom Sporty Theme -->
    <style>
            :root {
                --indela-primary: #FF5722; /* Energetic Orange */
                --indela-dark: #1A1A2E; /* Deep Navy/Black */
                --indela-light: #F8F9FA;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--indela-light);
                color: #333;
            }

            h1, h2, h3, h4, h5, h6, .navbar-brand {
                font-family: 'Montserrat', sans-serif;
                font-weight: 800;
            }

            /* Navbar */
            .navbar {
                background-color: #ffffff !important;
                border-bottom: 4px solid var(--indela-primary) !important;
            }

            .navbar-brand {
                color: var(--indela-dark) !important;
                font-size: 1.5rem;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

                .navbar-brand span {
                    color: var(--indela-primary);
                }

            .nav-link {
                font-weight: 600;
                transition: color 0.2s;
            }

                .nav-link:hover {
                    color: var(--indela-primary) !important;
                }

            /* Buttons */
            .btn-primary {
                background-color: var(--indela-primary);
                border-color: var(--indela-primary);
                font-weight: 600;
                border-radius: 50px;
                padding: 8px 24px;
            }

                .btn-primary:hover {
                    background-color: #E64A19;
                    border-color: #E64A19;
                }

            .btn-success {
                background-color: #00BFA6;
                border-color: #00BFA6;
                border-radius: 50px;
            }

            /* Cards */
            .card {
                border: none;
                border-radius: 15px;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

                .card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
                }

            /* Footer */
            .footer {
                background-color: #ffffff;
                border-top: 1px solid #eee;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light box-shadow mb-4">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="iNDLELA Logo" style="height: 45px; margin-right: 10px;" />
                    <span>i<span>NDLELA</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Left Side Links -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event me-1"></i> Browse Events
                            </a>
                        </li>

                        <!-- Role-Specific Links -->
                        @if (Context.Session.GetString("UserRole") == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold" style="color: var(--indela-primary);" asp-controller="Organiser" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> My Dashboard
                                </a>
                            </li>
                        }
                        @if (Context.Session.GetString("UserRole") == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold" style="color: var(--indela-primary);" asp-controller="Participant" asp-action="Dashboard">
                                    <i class="bi bi-journal-check me-1"></i> My Entries
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold" style="color: var(--indela-primary);" asp-controller="Participant" asp-action="MyResults">
                                    <i class="bi bi-trophy me-1"></i> My Results
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Right Side Session Links -->
                    <ul class="navbar-nav align-items-center">
                        @if (Context.Session.GetString("JwtToken") != null)
                        {
                            var profilePic = Context.Session.GetString("ProfileImageUrl");

                            // DOCKER FIX: If it's a local upload, point it to the API container
                            var displayPic = profilePic;
                            if (!string.IsNullOrEmpty(profilePic) && profilePic.StartsWith("/uploads/"))
                            {
                                displayPic = $"http://localhost:7100{profilePic}";
                            }

                            <li class="nav-item me-3">
                                <a class="nav-link text-dark fw-bold p-0 d-flex align-items-center text-decoration-none" asp-controller="Account" asp-action="Profile" title="Click to edit profile">

                                    <!-- Profile Picture or Fallback Icon -->
                                    @if (!string.IsNullOrEmpty(displayPic))
                                    {
                                        <img src="@displayPic" class="rounded-circle me-2 shadow-sm" style="width: 40px; height: 40px; object-fit: cover; border: 2px solid var(--indela-primary);" alt="Avatar" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 40px; height: 40px; font-size: 1.2rem;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                    }

                                    <!-- Name and Role -->
                                    <div class="d-flex flex-column text-start">
                                        <span style="font-family: 'Inter', sans-serif; font-size: 0.9rem;">Hello, @Context.Session.GetString("UserName")!</span>
                                        <span class="badge mt-1" style="background-color: var(--indela-dark); font-size: 0.7em; align-self: flex-start;">@Context.Session.GetString("UserRole")</span>
                                    </div>
                                </a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm" style="border-radius: 50px;">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-primary text-white" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; 2026 - <strong>iNDLELA</strong>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
