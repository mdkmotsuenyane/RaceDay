@model RaceDay.DTOs.UpdateEventRequestDto
@{ ViewBag.Title = "Edit Event"; }

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-body p-4">
            <h3 class="card-title mb-4">Edit Event</h3>
            
            <!-- Notice the asp-route-id to pass the EventId to the controller -->
            <form asp-action="EditEvent" asp-route-id="@ViewBag.EventId" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Event Name</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label">Event Date</label>
                        <input asp-for="EventDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartTime" class="form-label">Start Time</label>
                        <input asp-for="StartTime" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label">Location</label>
                    <input asp-for="Location" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="Closed">Closed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartPoint" class="form-label">Start Point</label>
                        <input asp-for="StartPoint" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="FinishPoint" class="form-label">Finish Point</label>
                        <input asp-for="FinishPoint" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
