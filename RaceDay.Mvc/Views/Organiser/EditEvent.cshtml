@model RaceDay.DTOs.UpdateEventRequestDto
@{ ViewBag.Title = "Edit Event"; }

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-body p-4">
            <h3 class="card-title mb-4 fw-bold" style="color: var(--indela-dark);">Edit Event</h3>
            
            <form asp-action="EditEvent" asp-route-id="@ViewBag.EventId" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Event Name</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label fw-bold">Event Date</label>
                        <input asp-for="EventDate" type="date" class="form-control" required />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartTime" class="form-label fw-bold">Start Time</label>
                        <input asp-for="StartTime" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label fw-bold">Location</label>
                    <input asp-for="Location" class="form-control" required />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="Closed">Closed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartPoint" class="form-label fw-bold">Start Point</label>
                        <input asp-for="StartPoint" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="FinishPoint" class="form-label fw-bold">Finish Point</label>
                        <input asp-for="FinishPoint" class="form-control" />
                    </div>
                </div>

            <!--waether inputs-->
                <h5 class="mt-4 border-bottom pb-2 fw-bold">Weather Forecast (Optional)</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="WeatherForecast" class="form-label"></label>
                        <input asp-for="WeatherForecast" class="form-control" placeholder="e.g., Sunny with light clouds" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Temperature" class="form-label"></label>
                        <input asp-for="Temperature" class="form-control" placeholder="e.g., 22.5" />
                        <span asp-validation-for="Temperature" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="WindSpeed" class="form-label"></label>
                        <input asp-for="WindSpeed" class="form-control" placeholder="e.g., 15" />
                        <span asp-validation-for="WindSpeed" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Precipitation" class="form-label"></label>
                        <input asp-for="Precipitation" class="form-control" placeholder="e.g., 0" />
                        <span asp-validation-for="Precipitation" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4 mt-3">
                    <label class="form-label fw-bold">Update Banner Image (Optional)</label>
                    <input type="file" name="NewImage" class="form-control" accept="image/*" />
                    <div class="form-text">Upload a new image to replace the current banner.</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Dashboard" class="btn btn-secondary px-4" style="border-radius: 50px;">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" style="border-radius: 50px;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
