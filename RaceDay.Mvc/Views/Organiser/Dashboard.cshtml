@model List<RaceDay.DTOs.EventResponseDto>
@{
    ViewBag.Title = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Events</h2>
        <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">You haven't created any events yet.</div>
    }
    else
    {
        <table class="table table-hover shadow-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Status</th>
                    <!-- ADDED ENROLMENTS HEADER -->
                    <th>Enrolments</th> 
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td class="fw-bold">@ev.Name</td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@ev.Location</td>
                        <td><span class="badge bg-secondary">@ev.Status</span></td>
                        
                        <!-- ADDED ENROLMENTS DATA -->
                        <td>
                            <span class="badge bg-info text-dark">
                                @(ViewBag.EntryCounts != null && ViewBag.EntryCounts.ContainsKey(ev.EventID) ? ViewBag.EntryCounts[ev.EventID] : 0) Entries
                            </span>
                        </td>
                        
                        <td>
                            <!-- Button Group -->
                            <div class="btn-group" role="group">
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-primary">View</a>
                                
                                <a asp-action="ManageEntries" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-success">Entries</a>
                                
                                <a asp-action="ManageCategories" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-info">Categories</a>
                                <a asp-action="EditEvent" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-warning">Edit</a>
                            </div>

                            <!-- Delete Form -->
                            <form asp-action="DeleteEvent" asp-route-id="@ev.EventID" method="post" class="d-inline ms-1" onsubmit="return confirm('Are you sure you want to delete this event? This will also remove any categories and entries.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
