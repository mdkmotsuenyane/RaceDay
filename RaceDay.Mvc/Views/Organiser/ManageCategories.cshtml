@{
}
@model List<RaceDay.DTOs.CategoryResponseDto>
@{
    ViewBag.Title = "Manage Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Categories for @ViewBag.EventName</h2>
            <a asp-action="Dashboard" class="text-muted text-decoration-none">&larr; Back to Dashboard</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <!-- List of Categories -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">Existing Categories</div>
                <ul class="list-group list-group-flush">
                    @if (!Model.Any())
                    {
                        <li class="list-group-item text-muted">No categories created yet.</li>
                    }
                    else
                    {
                        @foreach (var cat in Model)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-1">@cat.Name</h5>
                                    <small class="text-muted">
                                        Distance: @cat.Distance km | Age: @cat.MinAge-@cat.MaxAge | 
                                        Gender: @(string.IsNullOrEmpty(cat.Gender) ? "Open" : cat.Gender)
                                    </small>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>

        <!-- Add Category Form -->
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">Add New Category</div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post">
                        <input type="hidden" name="eventId" value="@ViewBag.EventId" />
                        
                        <div class="mb-3">
                            <label class="form-label">Category Name</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. Men Open 42km" required />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Distance (km)</label>
                            <input type="number" step="0.1" name="Distance" class="form-control" placeholder="42.2" required />
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Min Age</label>
                                <input type="number" name="MinAge" class="form-control" value="18" required />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Max Age</label>
                                <input type="number" name="MaxAge" class="form-control" value="99" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Gender</label>
                            <select name="Gender" class="form-select">
                                <option value="">Open (Any)</option>
                                <option value="M">Male Only</option>
                                <option value="F">Female Only</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Add Category</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
