@model RaceDay.Mvc.Models.ProfileViewModel
@{ ViewBag.Title = "My Profile"; }

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            
            <!-- THIS IS THE MISSING ERROR BOX -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">My Profile</h5>
                </div>
                <div class="card-body p-4">
                    
                    <!-- Avatar Section -->
                    <div class="text-center mb-4 position-relative">
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <img src="@Model.ProfileImageUrl" class="rounded-circle shadow" style="width: 140px; height: 140px; object-fit: cover;" alt="Avatar" />
                            
                            <form asp-action="DeleteProfilePicture" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove your profile picture?');">
                                    Remove Picture
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow" style="width: 140px; height: 140px; font-size: 4rem;">
                                👤
                            </div>
                        }
                        
                        <h4 class="mt-3 mb-1">@Model.FullName</h4>
                        <p class="text-muted">
                            @Model.Email 
                            <span class="badge bg-primary ms-2">@Model.Role</span>
                        </p>
                    </div>

                    <!-- Edit Form -->
                    <form asp-action="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-bold"></label>
                                <input asp-for="FullName" class="form-control" required />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold"></label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                        </div>

                        @if (Model.Role == "Participant")
                        {
                            <div class="mb-3">
                                <label asp-for="EmergencyContact" class="form-label fw-bold"></label>
                                <input asp-for="EmergencyContact" class="form-control" placeholder="Name & Number" />
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="ProfileImage" class="form-label fw-bold"></label>
                            <input asp-for="ProfileImage" type="file" class="form-control" accept="image/*" />
                            <div class="form-text">Upload a JPG or PNG. Max size 5MB.</div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
